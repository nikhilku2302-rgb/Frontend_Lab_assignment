<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Marksheet</title>

    <style>
         {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #667eea, #764ba2);
            min-height: 100vh;
            padding: 40px 20px;
        }

        .container {
            max-width: 850px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        }

        
        .header {
            text-align: center;
            margin-bottom: 25px;
        }

        .header h1 {
            color: #4b3ca7;
            margin-bottom: 8px;
        }

        .header p {
            color: #666;
        }

        
        .student-details {
            display: flex;
            justify-content: space-between;
            background: #f3f1ff;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .student-details p {
            margin: 5px;
            color: #333;
        }

        /* Table */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th {
            background: #5146a6;
            color: white;
            padding: 14px;
        }

        td {
            padding: 12px;
            text-align: center;
            border-bottom: 1px solid #ddd;
        }

        tr:nth-child(even) {
            background-color: #f7f7ff;
        }

        tr:hover {
            background-color: #eeeaff;
        }

        .total {
            font-weight: bold;
            background-color: #e8e4ff !important;
        }

        
        .summary {
            margin-top: 25px;
        }

        .summary h2 {
            color: #4b3ca7;
            margin-bottom: 10px;
        }

        .summary ul {
            list-style-type: square;
            padding-left: 25px;
            line-height: 1.8;
        }

        
        .result {
            margin-top: 25px;
            text-align: center;
            padding: 15px;
            background: #e8f8ee;
            border-radius: 10px;
            color: #218838;
            font-size: 20px;
            font-weight: bold;
        }

        
        .footer {
            text-align: center;
            margin-top: 25px;
            color: #777;
            font-size: 14px;
        }

       
        @media (max-width: 600px) {
            .student-details {
                flex-direction: column;
            }

            .container {
                padding: 20px;
            }

            th, td {
                padding: 8px;
                font-size: 14px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="header">
            <h1>GLA University</h1>
            <p><b>Student Marksheet</b></p>
            <p>Academic Session: 2025-26</p>
        </div>

        
        <div class="student-details">

            <div>
                <p><b>Name:</b> Nikhil Kumar</p>
                <p><b>Roll No:</b> 11</p>
            </div>

            <div>
                <p><b>Course:</b> B.Tech CSE</p>
                <p><b>Semester:</b> 5th</p>
            </div>

        </div>

        
        <table>

            <tr>
                <th>S.No.</th>
                <th>Subject</th>
                <th>Max Marks</th>
                <th>Marks Obtained</th>
                <th>Grade</th>
            </tr>

            <tr>
                <td>1</td>
                <td>Java</td>
                <td>100</td>
                <td>85</td>
                <td>A</td>
            </tr>

            <tr>
                <td>2</td>
                <td>Data Structures</td>
                <td>100</td>
                <td>90</td>
                <td>A+</td>
            </tr>

            <tr>
                <td>3</td>
                <td>Web Development</td>
                <td>100</td>
                <td>88</td>
                <td>A+</td>
            </tr>

            <tr>
                <td>4</td>
                <td>Database Management</td>
                <td>100</td>
                <td>78</td>
                <td>B+</td>
            </tr>

            <tr>
                <td>5</td>
                <td>Computer Networks</td>
                <td>100</td>
                <td>82</td>
                <td>A</td>
            </tr>

            <tr class="total">
                <td colspan="2">Total</td>
                <td>500</td>
                <td>423</td>
                <td>A</td>
            </tr>

        </table>

        
        <div class="summary">

            <h2>Academic Summary</h2>

            <ul>
                <li>Total Subjects: 5</li>
                <li>Total Marks: 500</li>
                <li>Marks Obtained: 423</li>
                <li>Percentage: 84.6%</li>
                <li>Overall Grade: A</li>
            </ul>

        </div>

        
        <div class="result">
            RESULT: PASS
        </div>

        
        <div class="footer">
            <p>© 2026 GLA University | Student Marksheet</p>
        </div>

    </div>

</body>
</html>
